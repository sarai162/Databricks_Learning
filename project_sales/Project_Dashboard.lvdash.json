{
  "datasets": [
    {
      "name": "45fa907b",
      "displayName": "gold_aggregates",
      "config": {
        "version": "1.1",
        "source": "project.sales.gold_aggregates",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "displayName": "Average Order Value",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              },
              "hideGroupSeparator": false
            },
            "name": "avg_order_value",
            "expr": "SUM(`toatl_sales`) / SUM(`total_orders`)",
            "comment": "Total sales divided by total number of orders"
          },
          {
            "displayName": "Average Price per Item",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              },
              "hideGroupSeparator": false
            },
            "name": "avg_price_per_item",
            "expr": "SUM(`toatl_sales`) / SUM(`total_quantity`)",
            "comment": "Total sales divided by total quantity sold, weighted by units"
          }
        ]
      }
    }
  ],
